# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GROQ_API_KEY: For high-speed AI inference (Resume tailoring, cover letters).
GROQ_API_KEY="your_groq_api_key_here"

# FIRECRAWLER_API_KEY: For scraping job boards and career pages.
FIRECRAWLER_API_KEY="your_firecrawler_api_key_here"

# TAVILY_API_KEY: For deep search of company career portals.
TAVILY_API_KEY="your_tavily_api_key_here"

# CLOUDFLARE_API_TOKEN: Optional for additional workers/parsing.
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"

# SUPABASE_URL & SUPABASE_ANON_KEY: For saving bookmarks and applications.
VITE_SUPABASE_URL="your_supabase_url_here"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
